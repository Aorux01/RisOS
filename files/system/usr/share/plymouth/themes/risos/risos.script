# RisOS Plymouth theme: boot splash and system-update screen.
# Layout follows style/Démarrage@2x.png and style/Mise à jour@2x.png (reference 2000x1250).
# Images are rendered at 2x the reference by files/scripts/plymouth.sh, hence R.
# Plymouth script: inside functions, globals must be accessed with "global.".

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();
cx = sw / 2;
k = sh / 1250;   # reference px -> screen px
R = 2;           # render scale of the PNGs
s = k / R;       # PNG px -> screen px

fun load(name) {
  img = Image(name + ".png");
  return img.Scale(img.GetWidth() * global.s, img.GetHeight() * global.s);
}

fun place_centered(img, y) {
  sprite = Sprite(img);
  sprite.SetX(global.cx - img.GetWidth() / 2);
  sprite.SetY(y);
  return sprite;
}

mode = Plymouth.GetMode();
is_update = 0;
if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade") is_update = 1;

logo = load("logo");
logo_size = logo.GetWidth();

if (is_update) {
  place_centered(logo, 446 * k - logo_size / 2);
  place_centered(load("title"), 604 * k);
  bar_w = 562 * k;
  bar_y = 697 * k;
  place_centered(load("note"), 790 * k);
} else {
  place_centered(logo, 578 * k - logo_size / 2);
  bar_w = 250 * k;
  bar_y = 768 * k;
}
bar_x = cx - bar_w / 2;
bar_h = 7 * k;

# Progress bar: a dark track and a gradient fill.
track_img = Image("bar-track.png");
track = Sprite(track_img.Scale(bar_w, bar_h));
track.SetX(bar_x);
track.SetY(bar_y);

fill_img = Image("bar-fill.png");
fill = Sprite();
fill.SetY(bar_y);

fun set_fill(x, w) {
  if (w < global.bar_h) w = global.bar_h;
  global.fill.SetImage(global.fill_img.Scale(w, global.bar_h));
  global.fill.SetX(x);
}

if (is_update) {
  # Real progress, driven by "plymouth system-update --progress=N".
  set_fill(bar_x, 0);

  status_sprite = Sprite(load("status"));
  status_sprite.SetX(bar_x);
  status_sprite.SetY(722 * k);

  digits = [];
  for (i = 0; i < 10; i++) digits["" + i] = load("d" + i);
  pct_img = load("pct");
  pct_sprites = [];
  pct_count = 0;

  fun show_percent(n) {
    for (j = 0; j < global.pct_count; j++) global.pct_sprites[j].SetOpacity(0);
    text = "" + n;
    len = StringLength(text);
    total = global.pct_img.GetWidth();
    for (j = 0; j < len; j++) total += global.digits[StringCopy(text, j, 1)].GetWidth();
    x = global.bar_x + global.bar_w - total;
    count = 0;
    for (j = 0; j < len; j++) {
      img = global.digits[StringCopy(text, j, 1)];
      global.pct_sprites[count] = Sprite(img);
      global.pct_sprites[count].SetX(x);
      global.pct_sprites[count].SetY(722 * global.k);
      x += img.GetWidth();
      count++;
    }
    global.pct_sprites[count] = Sprite(global.pct_img);
    global.pct_sprites[count].SetX(x);
    global.pct_sprites[count].SetY(722 * global.k);
    global.pct_count = count + 1;
  }
  show_percent(0);

  fun system_update(progress) {
    if (progress < 0) progress = 0;
    if (progress > 100) progress = 100;
    set_fill(global.bar_x, global.bar_w * progress / 100);
    show_percent(progress);
  }
  Plymouth.SetSystemUpdateFunction(system_update);
} else {
  # Boot progress is not reliable, so use an indeterminate animation:
  # a segment gliding back and forth along the track.
  seg_w = bar_w * 0.3;
  tick = 0;

  fun animate() {
    global.tick++;
    t = global.tick / 50;                       # ~50 refreshes per second
    pos = (1 - Math.Cos(t * 3.14159 / 1.1)) / 2; # 0 -> 1 -> 0, full cycle every 2.2 s
    set_fill(global.bar_x + (global.bar_w - global.seg_w) * pos, global.seg_w);
  }
  Plymouth.SetRefreshFunction(animate);
}
